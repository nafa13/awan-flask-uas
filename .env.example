# Konfigurasi Aplikasi Flask
SECRET_KEY=super-secret-key-change-this-in-production
FLASK_APP=app.py
FLASK_ENV=development

# Konfigurasi Database (MySQL via Docker Container)
DATABASE_URL=mysql+pymysql://root:rootpassword@db:3306/farmassist_db

# Konfigurasi Database Lokal (Uncomment jika menjalankan tanpa Docker)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/farmassist_db

# Konfigurasi Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Konfigurasi Cloudflare R2 / S3 Object Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your-public-url.r2.dev
